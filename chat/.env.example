# Build pipeline (all optional — defaults live in src/portfolio_rag/config.py)
RAG_CHUNK_SIZE="800"
RAG_CHUNK_OVERLAP="100"
# The committed chat/data/chunks_e5.json, gate_en_minilm.json and
# chunks_en_minilm.json (gate_zh_bge.json too, if calibrated -- gitignored)
# were all built with e5, and the deployed Tencent function expects e5 query
# vectors — leave this as "e5" or a fresh clone's build_index.py will
# regenerate the retrieval corpus in a different embedding space and desync
# the deployed backend. RAG_MODEL_PRESET only names the RETRIEVAL model, but
# the gate models are declared *inside* the e5 preset (gate_model: "minilm",
# gate_model_zh: "bge_zh") — so setting "e5" is also what enables the MiniLM
# English gate and the bge-zh Chinese gate. Switching to "minilm" sets both
# gate models to None: no gate_en_minilm.json/gate_zh_bge.json/
# chunks_en_minilm.json are written at all, and the Chinese gate is disabled
# entirely.
RAG_MODEL_PRESET="e5"

# Tencent SCF function secrets are NOT set through .env files.
# They're set as environment variables on the function itself, in the SCF
# console (see .claude/DEPLOY.md for the full walkthrough) -- they never touch
# this repo.

# Build pipeline (all optional — defaults live in src/portfolio_rag/config.py)
RAG_CHUNK_SIZE="800"
RAG_CHUNK_OVERLAP="100"
# The committed chat/data/index.json, gate_vectors.json and
# fallback_vectors.json were all built with e5, and the deployed Tencent
# function expects e5 query vectors — leave this as "e5" or a fresh clone's
# build_index.py will regenerate the index in a different embedding space
# and desync the deployed backend. RAG_MODEL_PRESET only names the RETRIEVAL
# model, but the gate models are declared *inside* the e5 preset
# (gate_model: "minilm", gate_model_zh: "bge_zh") — so setting "e5" is also
# what enables the MiniLM English gate and the bge-zh Chinese gate.
# Switching to "minilm" sets both gate models to None: no gate_vectors.json
# is written at all, and the Chinese gate is disabled entirely.
RAG_MODEL_PRESET="e5"

# Cloudflare Worker secrets are NOT set through .env files.
# After `cd chat/worker`, set them with wrangler so they never touch the repo:
#   npx wrangler secret put ANTHROPIC_API_KEY
# Non-secret worker vars (model name, allowed origins) live in worker/wrangler.toml.
